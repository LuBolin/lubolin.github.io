---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Other Stuff" description="A quiet doorway to Shangri-La, an interactive 3D experiment by Bloin.">
  <div class="page-shell max-w-3xl">
    <p class="m-0 text-sm font-bold uppercase tracking-[.15em] text-primary">Other Stuff</p>
    <h1 class="page-heading mt-2">A doorway travels with you.</h1>
    <p class="page-lede">Look for the little portal in the corner. It leads to Shangri-La.</p>
  </div>
</BaseLayout>
