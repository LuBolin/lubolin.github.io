---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertUniqueContent, formatDate, normalizeTag, publishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  assertUniqueContent(allPosts);
  const posts = publishedPosts(allPosts);
  const tags = new Map<string, { label: string; posts: typeof posts }>();
  for (const post of posts) for (const label of post.data.tags) {
    const tag = normalizeTag(label);
    const group = tags.get(tag) ?? { label, posts: [] };
    group.posts.push(post);
    tags.set(tag, group);
  }
  return [...tags].map(([tag, group]) => ({ params: { tag }, props: group }));
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged ${label}`} description={`Bloin's published posts tagged ${label}.`}>
  <div class="page-shell max-w-4xl">
    <p class="m-0 text-sm font-bold uppercase tracking-[.16em] text-primary">Tag</p>
    <h1 class="page-heading">{label}</h1>
    <ol class="mt-8 grid list-none gap-4 p-0">
      {posts.map(({ data }) => <li class="ridge-card p-5"><h2 class="m-0 text-2xl"><a href={`/blog/${data.slug}/`}>{data.title}</a></h2><p class="my-2">{data.description}</p><time class="text-sm text-muted" datetime={data.published.toISOString()}>{formatDate(data.published)}</time></li>)}
    </ol>
  </div>
</BaseLayout>
