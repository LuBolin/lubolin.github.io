---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Shangri-La" description="Explore Bloin's floating-island Three.js experiment.">
  <div class="page-shell">
    <a class="mb-5 inline-block text-primary" href="/others/">← Little experiments</a>
    <header class="profile-intro mb-6">
      <p class="home-eyebrow">3D world</p>
      <h1>Shangri-La</h1>
      <p>A floating island to explore. Drag to orbit and scroll to zoom.</p>
    </header>
    <section class="ridge-card relative h-[65svh] min-h-96" data-shangrila>
      <canvas class="absolute inset-0 h-full w-full touch-none" id="shangrila-canvas" aria-label="Interactive 3D floating island"></canvas>
      <div class="pointer-events-none absolute inset-0 grid place-items-center bg-primary/85 p-6 text-center text-white" data-shangrila-status role="status">
        <div><p class="m-0 text-sm font-bold uppercase tracking-[.18em]">Shangri-La</p><p class="mt-2 text-xl" data-shangrila-message>Loading the island…</p></div>
      </div>
      <div class="pointer-events-none absolute left-4 top-4 right-4">
        <p class="m-0 w-fit rounded-full border border-border bg-surface px-4 py-3 text-sm text-text">Drag to orbit · scroll to zoom</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../experiments/shangrila';
</script>
