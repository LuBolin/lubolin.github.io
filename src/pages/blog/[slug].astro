---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { assertUniqueContent, publishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  assertUniqueContent(allPosts);
  return publishedPosts(allPosts).map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout {...post.data}><Content /></PostLayout>
