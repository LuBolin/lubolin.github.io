---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertUniqueContent, formatDate, publishedPosts } from '../../lib/content';

const allPosts = await getCollection('blog');
assertUniqueContent(allPosts);
const posts = publishedPosts(allPosts);
---

<BaseLayout title="Blog" description="Notes about game design, programming, and other ideas.">
  <div class="page-shell max-w-5xl">
    <h1 class="page-heading">Blog</h1>
    <p class="page-lede">Notes about game design, programming, and other ideas.</p>
    <ol class="grid list-none gap-5 p-0">
      {posts.map(({ data }) => (
        <li><article class="ridge-card p-5 sm:p-7">
          <div class="flex flex-col items-start justify-between gap-3 sm:flex-row">
            <div class="min-w-0 flex-1"><h2 class="m-0 text-[clamp(1.7rem,4vw,2.5rem)] leading-tight"><a href={`/blog/${data.slug}/`}>{data.title}</a></h2><p class="mb-0 mt-2 text-lg">{data.description}</p></div>
            <time class="text-sm text-muted sm:shrink-0" datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
          </div>
          <ul class="tag-list mt-4">{data.tags.map((tag) => <li><a class="tag no-underline hover:underline" href={`/tags/${tag.trim().toLowerCase().replace(/\s+/g, '-')}/`}>{tag}</a></li>)}</ul>
        </article></li>
      ))}
    </ol>
  </div>
</BaseLayout>
