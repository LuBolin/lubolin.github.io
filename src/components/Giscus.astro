---
interface Props { slug: string }
const { slug } = Astro.props;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const configured = Boolean(repoId && categoryId);
---

{configured && (
  <section aria-labelledby="comments-heading" class="mt-12 border-t border-border pt-8">
    <h2 id="comments-heading">Comments</h2>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo="LuBolin/lubolin.github.io"
      data-repo-id={repoId}
      data-category="General"
      data-category-id={categoryId}
      data-mapping="specific"
      data-term={`post:${slug}`}
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="en"
      crossorigin="anonymous"
      async
    ></script>
  </section>
)}
