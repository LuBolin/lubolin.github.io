---
import { Image } from 'astro:assets';
import selfPortrait from '@/assets/images/self.jpg';

interface Props { path: string }
const { path } = Astro.props;
const isHome = path === '/';
const links = [
  ['/', 'Home'],
  ['/projects/', 'Projects'],
  ['/blog/', 'Blog'],
  ['/about/', 'About'],
  ['/contact/', 'Contact'],
];
const homeLinks = links.slice(1);
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class:list={['site-header', { 'site-header--home': isHome }]} transition:animate="none">
  <div class="site-header__inner" transition:persist={isHome ? undefined : 'site-header-inner'}>
    <a class="site-identity" href="/" aria-label="Bloin, home">
      {isHome && <Image src={selfPortrait} alt="" width={176} height={176} priority />}
      <span><strong>Bloin</strong>{isHome && <small>I make things.</small>}</span>
    </a>
    {isHome && (
      <nav class="home-explore" aria-label="Explore">
        <p class="home-explore__label">Explore</p>
        <ul class="site-nav">
          {homeLinks.map(([href, label]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    {/*
    {isHome && (
      <aside class="home-quote">
        <blockquote>“No man needs a vacation so much as the man who has just had one.”</blockquote>
        <cite>Elbert Hubbard</cite>
      </aside>
    )}
    */}
    <nav class:list={[{ 'home-primary-nav': isHome }]} aria-label="Primary navigation">
      <ul class="site-nav">
        {links.map(([href, label]) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
        <span class="sr-only" data-theme-label>Switch to dark mode</span>
        <span class="theme-toggle__track" aria-hidden="true">
          <span class="theme-toggle__sun">☀</span>
          <span class="theme-toggle__moon">☾</span>
          <span class="theme-toggle__thumb"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = toggle?.querySelector<HTMLElement>('[data-theme-label]');
  const syncThemeToggle = () => {
    const dark = root.dataset.theme === 'dark';
    toggle?.setAttribute('aria-pressed', String(dark));
    const action = dark ? 'Switch to light mode' : 'Switch to dark mode';
    toggle?.setAttribute('aria-label', action);
    toggle?.setAttribute('title', action);
    if (label) label.textContent = action;
  };
  const syncActiveLink = () => {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((link) => {
      const href = link.getAttribute('href');
      const active = href === '/' ? path === '/' : Boolean(href && path.startsWith(href));
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };
  syncThemeToggle();
  syncActiveLink();
  document.addEventListener('astro:after-swap', syncActiveLink);
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    syncThemeToggle();
  });
</script>
