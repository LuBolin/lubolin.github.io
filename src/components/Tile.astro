---
type TileSize = '1x1' | '2x1' | '2x2' | '4x1' | '4x2';
type TileTone = 'surface' | 'primary' | 'accent';
interface Props { size: TileSize; tone?: TileTone; href?: string; class?: string }
const { size, tone = 'surface', href, class: className = '' } = Astro.props;
const sizeClasses: Record<TileSize, string> = {
  '1x1': 'md:col-span-1 md:row-span-1',
  '2x1': 'md:col-span-2 md:row-span-1',
  '2x2': 'md:col-span-2 md:row-span-2',
  '4x1': 'md:col-span-4 md:row-span-1',
  '4x2': 'md:col-span-4 md:row-span-2',
};
const toneClasses: Record<TileTone, string> = {
  surface: 'bg-surface text-text border-border',
  primary: 'bg-primary text-white border-primary-dark',
  accent: 'bg-accent text-white border-text/20',
};
const classes = `group relative min-w-0 overflow-hidden rounded-xl border p-5 shadow-sm transition-transform duration-200 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-accent ${sizeClasses[size]} ${toneClasses[tone]} ${href ? 'block no-underline hover:-translate-y-0.5' : ''} ${className}`;
const Element = href ? 'a' : 'section';
---

<Element class={classes} href={href}><slot /></Element>
